+func TestMutantStaleHeartbeatAcceptance(t *testing.T) {
+	activate(t, staleHeartbeatID)
+	members := []raft.NodeID{"a", "b", "c"}
+	b := newNode(t, raft.Config{ID: "b", Members: members}, raft.PersistentState{HardState: raft.HardState{CurrentTerm: 2}})
+	effects := step(t, b, raft.Input{Kind: raft.InputMessage, Message: raft.Message{
+		Type: raft.AppendEntries, From: "a", To: "b", Term: 1, Sequence: 7,
+	}})
+	status := b.Status()
+	baseline := effectKindsEqual(effects, raft.EffectSend) && status.Role == raft.Follower && status.Term == 2 &&
+		status.Leader == "" && !status.AwaitingPersistence && effects[0].Message.Type == raft.AppendEntriesResponse &&
+		effects[0].Message.Term == 2 && !effects[0].Message.Success && effects[0].Message.RejectHint == 1
+	if baseline {
+		return
+	}
+	activated := effectKindsEqual(effects, raft.EffectResetElectionTimer, raft.EffectSend) && status.Role == raft.Follower &&
+		status.Term == 2 && status.Leader == "" && !status.AwaitingPersistence && effects[1].Message.Type == raft.AppendEntriesResponse &&
+		effects[1].Message.Term == 2 && effects[1].Message.Success && effects[1].Message.MatchIndex == 0 && effects[1].Message.RejectHint == 0
+	if !activated {
+		t.Fatalf("unexpected stale-heartbeat behavior effects=%+v status=%+v", effects, status)
+	}
+	failInvariant(t, "raft/stale-heartbeat-rejection", "stale heartbeat reset the timer and received success")
+}
