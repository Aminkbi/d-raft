+func TestMutantUnsafeOneStepReconfiguration(t *testing.T) {
+	activate(t, unsafeReconfigurationID)
+	members := []raft.NodeID{"a", "b", "c", "d"}
+	initial := raft.StableMembership([]raft.NodeID{"a", "b", "c"}, []raft.NodeID{"d"})
+	target := raft.StableMembership([]raft.NodeID{"b", "c", "d"}, []raft.NodeID{"a"})
+	wantJoint := raft.Membership{Voters: target.Voters, VotersOutgoing: initial.Voters, LearnersNext: target.Learners}
+	a := newNode(t, raft.Config{ID: "a", Members: members, Voters: initial.Voters, Learners: initial.Learners}, raft.PersistentState{})
+	electLeader(t, a, "b")
+	effects := step(t, a, raft.Input{Kind: raft.InputBeginMembership, Voters: target.Voters, Learners: target.Learners})
+	status := a.Status()
+	if !effectKindsEqual(effects, raft.EffectPersist) || !status.AwaitingPersistence || len(effects[0].State.Log) != 2 {
+		t.Fatalf("unexpected membership effects=%+v status=%+v", effects, status)
+	}
+	entry := effects[0].State.Log[1]
+	if entry.Type == raft.EntryConfigJoint && raft.MembershipsEqual(entry.Membership, wantJoint) {
+		return
+	}
+	if entry.Type != raft.EntryConfigFinal || entry.Membership.Joint() || !raft.MembershipsEqual(entry.Membership, target) {
+		t.Fatalf("unexpected membership entry=%+v status=%+v", entry, status)
+	}
+	violations := check.NewWithMembership(members, initial).Observe(check.Observation{Members: members, Nodes: []check.NodeObservation{
+		{ID: "a", Durable: effects[0].State},
+		{ID: "b", Durable: raft.PersistentState{}},
+		{ID: "c", Durable: raft.PersistentState{}},
+		{ID: "d", Durable: raft.PersistentState{}},
+	}})
+	failOnExactViolation(t, check.MembershipTransition, violations, "stable membership was replaced without a joint phase")
+}
+
+func newNode(t *testing.T, config raft.Config, state raft.PersistentState) *raft.Node {
+	t.Helper()
+	node, err := raft.New(config, state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return node
+}
+
+func step(t *testing.T, node *raft.Node, input raft.Input) []raft.Effect {
+	t.Helper()
+	effects, err := node.Step(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return effects
+}
+
+func acknowledge(t *testing.T, node *raft.Node, effects []raft.Effect) (raft.Effect, []raft.Effect) {
+	t.Helper()
+	if !effectKindsEqual(effects, raft.EffectPersist) || effects[0].WriteToken == 0 {
+		t.Fatalf("effects before persistence = %+v", effects)
+	}
+	after := step(t, node, raft.Input{Kind: raft.InputPersisted, WriteToken: effects[0].WriteToken})
+	return effects[0], after
+}
+
+func electLeader(t *testing.T, node *raft.Node, voter raft.NodeID) raft.Effect {
+	t.Helper()
+	_, _ = acknowledge(t, node, step(t, node, raft.Input{Kind: raft.InputElectionTimeout}))
+	term := node.Status().Term
+	persist, _ := acknowledge(t, node, step(t, node, raft.Input{Kind: raft.InputMessage, Message: raft.Message{
+		Type: raft.RequestVoteResponse, From: voter, To: node.Status().ID, Term: term, VoteGranted: true,
+	}}))
+	if status := node.Status(); status.Role != raft.Leader || status.AwaitingPersistence {
+		t.Fatalf("leader status = %+v", status)
+	}
+	return persist
+}
+
+func findMessage(t *testing.T, effects []raft.Effect, kind raft.MessageType, to raft.NodeID) raft.Message {
+	t.Helper()
+	for _, effect := range effects {
+		if effect.Kind == raft.EffectSend && effect.Message.Type == kind && effect.Message.To == to {
+			return raft.CloneMessage(effect.Message)
+		}
+	}
+	t.Fatalf("message %s to %q not found in %+v", kind, to, effects)
+	return raft.Message{}
+}
+
+func effectKindsEqual(effects []raft.Effect, want ...raft.EffectKind) bool {
+	if len(effects) != len(want) {
+		return false
+	}
+	for index, effect := range effects {
+		if effect.Kind != want[index] {
+			return false
+		}
+	}
+	return true
+}
+
+func activate(t *testing.T, id string) {
+	t.Helper()
+	t.Log("DRAFT_MUTANT_ACTIVATED:" + id)
+}
+
+func failOnExactViolation(t *testing.T, invariant string, violations []check.Violation, detail string) {
+	t.Helper()
+	if len(violations) != 1 || violations[0].ID != invariant {
+		t.Fatalf("unexpected checker violations = %+v", violations)
+	}
+	failInvariant(t, invariant, detail)
+}
+
+func failInvariant(t *testing.T, invariant, detail string) {
+	t.Helper()
+	t.Log("DRAFT_MUTANT_INVARIANT:" + invariant)
+	t.Fatal(detail)
+}

