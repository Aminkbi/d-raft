+package raft_test
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/aminkbi/d-raft/check"
+	"github.com/aminkbi/d-raft/raft"
+)
+
+const (
+	nonPersistedVoteID      = "non-persisted-vote"
+	duplicateVoteCountID    = "duplicate-vote-count"
+	ignoredHigherTermID     = "ignored-higher-term"
+	staleHeartbeatID        = "stale-heartbeat-acceptance"
+	snapshotBeforePersistID = "snapshot-before-persistence"
+	unsafeReconfigurationID = "unsafe-one-step-reconfiguration"
+)
+
+func TestMutantNonPersistedVote(t *testing.T) {
+	activate(t, nonPersistedVoteID)
+	members := []raft.NodeID{"a", "b", "c"}
+	a := newNode(t, raft.Config{ID: "a", Members: members}, raft.PersistentState{HardState: raft.HardState{CurrentTerm: 3}})
+	_, campaignEffects := acknowledge(t, a, step(t, a, raft.Input{Kind: raft.InputElectionTimeout}))
+	request := findMessage(t, campaignEffects, raft.RequestVote, "b")
+	if request.Term != 4 {
+		t.Fatalf("campaign request = %+v", request)
+	}
+
+	b := newNode(t, raft.Config{ID: "b", Members: members}, raft.PersistentState{})
+	effects := step(t, b, raft.Input{Kind: raft.InputMessage, Message: request})
+	status := b.Status()
+	state := b.State()
+	baseline := effectKindsEqual(effects, raft.EffectPersist) &&
+		status.Role == raft.Follower && status.Term == 4 && status.VotedFor == "a" && status.AwaitingPersistence &&
+		state.Pending != nil && effectKindsEqual(state.Pending.Effects, raft.EffectResetElectionTimer, raft.EffectSend)
+	if baseline {
+		return
+	}
+	activated := effectKindsEqual(effects, raft.EffectPersist, raft.EffectSend) &&
+		status.Role == raft.Follower && status.Term == 4 && status.VotedFor == "a" && status.AwaitingPersistence &&
+		state.Pending != nil && effectKindsEqual(state.Pending.Effects, raft.EffectResetElectionTimer) &&
+		effects[1].Message.Type == raft.RequestVoteResponse && effects[1].Message.From == "b" && effects[1].Message.To == "a" &&
+		effects[1].Message.Term == 4 && effects[1].Message.VoteGranted
+	if !activated {
+		t.Fatalf("unexpected vote behavior effects=%+v status=%+v pending=%+v", effects, status, state.Pending)
+	}
+
+	leaderPersist, _ := acknowledge(t, a, step(t, a, raft.Input{Kind: raft.InputMessage, Message: effects[1].Message}))
+	leaderStatus := a.Status()
+	if leaderStatus.Role != raft.Leader || leaderStatus.AwaitingPersistence || !slices.Equal(leaderStatus.ElectionVotes, []raft.NodeID{"a", "b"}) {
+		t.Fatalf("leader status = %+v", leaderStatus)
+	}
+	violations := check.New(members).Observe(check.Observation{Members: members, Nodes: []check.NodeObservation{
+		{ID: "a", Up: true, Status: &leaderStatus, Durable: leaderPersist.State},
+		{ID: "b", Durable: raft.PersistentState{}},
+		{ID: "c", Durable: raft.PersistentState{}},
+	}})
+	failOnExactViolation(t, check.ElectionCertificate, violations, "vote response escaped before its durable write")
+}
+
+func TestMutantDuplicateVoteCount(t *testing.T) {
+	activate(t, duplicateVoteCountID)
+	members := []raft.NodeID{"a", "b", "c", "d", "e"}
+	a := newNode(t, raft.Config{ID: "a", Members: members}, raft.PersistentState{})
+	_, _ = acknowledge(t, a, step(t, a, raft.Input{Kind: raft.InputElectionTimeout}))
+	reply := raft.Message{Type: raft.RequestVoteResponse, From: "b", To: "a", Term: 1, VoteGranted: true}
+	if effects := step(t, a, raft.Input{Kind: raft.InputMessage, Message: reply}); len(effects) != 0 || a.Status().Role != raft.Candidate {
+		t.Fatalf("first response effects=%+v status=%+v", effects, a.Status())
+	}
+	effects := step(t, a, raft.Input{Kind: raft.InputMessage, Message: reply})
+	status := a.Status()
+	if len(effects) == 0 && status.Role == raft.Candidate && !status.AwaitingPersistence && slices.Equal(a.State().Votes, []raft.NodeID{"a", "b"}) {
+		return
+	}
+	if !effectKindsEqual(effects, raft.EffectPersist) || status.Role != raft.Leader || !status.AwaitingPersistence ||
+		!slices.Equal(status.ElectionVotes, []raft.NodeID{"a", "b"}) || len(effects[0].State.Log) != 1 || effects[0].State.Log[0].Type != raft.EntryNoop {
+		t.Fatalf("unexpected duplicate response behavior effects=%+v status=%+v state=%+v", effects, status, a.State())
+	}
+	leaderPersist, _ := acknowledge(t, a, effects)
+	leaderStatus := a.Status()
+	violations := check.New(members).Observe(check.Observation{Members: members, Nodes: []check.NodeObservation{
+		{ID: "a", Up: true, Status: &leaderStatus, Durable: leaderPersist.State},
+		{ID: "b", Durable: raft.PersistentState{HardState: raft.HardState{CurrentTerm: 1, VotedFor: "a"}}},
+		{ID: "c", Durable: raft.PersistentState{}},
+		{ID: "d", Durable: raft.PersistentState{}},
+		{ID: "e", Durable: raft.PersistentState{}},
+	}})
+	failOnExactViolation(t, check.ElectionCertificate, violations, "one durable peer vote was counted twice")
+}
