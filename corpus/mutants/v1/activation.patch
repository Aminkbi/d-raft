+func TestMutantIgnoredHigherTerm(t *testing.T) {
+	activate(t, ignoredHigherTermID)
+	members := []raft.NodeID{"a", "b", "c"}
+	a := newNode(t, raft.Config{ID: "a", Members: members}, raft.PersistentState{})
+	electLeader(t, a, "b")
+	effects := step(t, a, raft.Input{Kind: raft.InputMessage, Message: raft.Message{
+		Type: raft.RequestVote, From: "c", To: "a", Term: 2, LastLogIndex: 1, LastLogTerm: 1,
+	}})
+	status := a.Status()
+	state := a.State()
+	baseline := effectKindsEqual(effects, raft.EffectPersist) && status.Role == raft.Follower && status.Term == 2 &&
+		status.VotedFor == "c" && status.AwaitingPersistence && state.Pending != nil &&
+		effectKindsEqual(state.Pending.Effects, raft.EffectResetElectionTimer, raft.EffectSend) &&
+		state.Pending.Effects[1].Message.Type == raft.RequestVoteResponse && state.Pending.Effects[1].Message.Term == 2 && state.Pending.Effects[1].Message.VoteGranted
+	if baseline {
+		return
+	}
+	activated := effectKindsEqual(effects, raft.EffectSend) && status.Role == raft.Leader && status.Term == 1 &&
+		status.VotedFor == "a" && !status.AwaitingPersistence && state.Pending == nil &&
+		effects[0].Message.Type == raft.RequestVoteResponse && effects[0].Message.From == "a" && effects[0].Message.To == "c" &&
+		effects[0].Message.Term == 1 && !effects[0].Message.VoteGranted
+	if !activated {
+		t.Fatalf("unexpected higher-term behavior effects=%+v status=%+v pending=%+v", effects, status, state.Pending)
+	}
+	failInvariant(t, "raft/higher-term-stepdown", "leader ignored a higher-term vote request")
+}
