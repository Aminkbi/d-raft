+func TestMutantSnapshotBeforePersistence(t *testing.T) {
+	activate(t, snapshotBeforePersistID)
+	members := []raft.NodeID{"a", "b", "c"}
+	b := newNode(t, raft.Config{ID: "b", Members: members}, raft.PersistentState{HardState: raft.HardState{CurrentTerm: 2}})
+	snapshot := raft.Snapshot{LastIncludedIndex: 5, LastIncludedTerm: 2, Members: members, Data: []byte("checkpoint")}
+	effects := step(t, b, raft.Input{Kind: raft.InputMessage, Message: raft.Message{
+		Type: raft.InstallSnapshot, From: "a", To: "b", Term: 2, Sequence: 9, Snapshot: snapshot,
+	}})
+	status := b.Status()
+	state := b.State()
+	baseline := effectKindsEqual(effects, raft.EffectPersist) && status.Term == 2 && status.CommitIndex == 5 && status.AwaitingPersistence &&
+		state.Pending != nil && effectKindsEqual(state.Pending.Effects, raft.EffectResetElectionTimer, raft.EffectInstallSnapshot, raft.EffectSend)
+	if baseline {
+		return
+	}
+	activated := effectKindsEqual(effects, raft.EffectPersist, raft.EffectInstallSnapshot) && status.Term == 2 &&
+		status.CommitIndex == 5 && status.AwaitingPersistence && effects[1].Snapshot.LastIncludedIndex == 5 &&
+		state.Pending != nil && effectKindsEqual(state.Pending.Effects, raft.EffectResetElectionTimer, raft.EffectSend) &&
+		state.Pending.Effects[1].Message.Type == raft.InstallSnapshotResponse && state.Pending.Effects[1].Message.Success
+	if !activated {
+		t.Fatalf("unexpected snapshot behavior effects=%+v status=%+v pending=%+v", effects, status, state.Pending)
+	}
+	failInvariant(t, "raft/snapshot-persistence-order", "snapshot installation escaped before durable persistence")
+}
